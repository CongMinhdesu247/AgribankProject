# Copy this file to .env locally, or configure these values in the hosting provider.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
IT_REGISTRATION_CODE=replace-with-a-private-invitation-code

# Backend server
PORT=5000
CORS_ORIGINS=http://localhost:5173

# MySQL (never use a root account for the public deployment)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=agribank_helpdesk
DB_USER=agribank_app
DB_PASSWORD=replace-with-a-strong-database-password
